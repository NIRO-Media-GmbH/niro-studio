{
  "name": "niro-motion-graphics",
  "version": "1.0.0",
  "description": "NIRO Motion Graphics Platform - Remotion-based 2D motion graphics production",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts",
    "render:transparent:prores": "remotion render src/index.ts --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:transparent:webm": "remotion render src/index.ts --image-format=png --pixel-format=yuva420p --codec=vp8",
    "render:web": "remotion render src/index.ts --codec=h264 --crf=18",
    "render:social": "remotion render src/index.ts --codec=h264 --crf=18",
    "render:draft": "remotion render src/index.ts --scale=0.5 --codec=h264 --crf=28",
    "render:gif": "remotion render src/index.ts --codec=gif --every-nth-frame=2 --number-of-gif-loops=0",
    "new:client": "npx tsx scripts/new-client.ts",
    "new:project": "npx tsx scripts/new-project.ts",
    "render:bs:azubi": "remotion render src/index.ts BremsenSchneider-Azubi out/bs-azubi-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:bs:fachkraft": "remotion render src/index.ts BremsenSchneider-Fachkraft out/bs-fachkraft-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:bs:meister": "remotion render src/index.ts BremsenSchneider-Meister out/bs-meister-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:bs:imagefilm": "remotion render src/index.ts BremsenSchneider-Imagefilm out/bs-imagefilm-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:se:leistungen": "remotion render src/index.ts SauberEntsorgen-Leistungen out/se-leistungen-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:se:erklaervideo": "remotion render src/index.ts SauberEntsorgen-Erklaervideo out/se-erklaervideo-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:se:reel1": "remotion render src/index.ts SauberEntsorgen-Reel1 out/se-reel1-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:se:reel2": "remotion render src/index.ts SauberEntsorgen-Reel2 out/se-reel2-overlay.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:st:pflegefachkraft": "remotion render src/index.ts Seniorenstiftung-Pflegefachkraft out/seniorenstiftung/pflegefachkraft.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:st:pflege-azubis": "remotion render src/index.ts Seniorenstiftung-PflegeAzubis out/seniorenstiftung/pflege-azubis.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:st:kuechenhilfe": "remotion render src/index.ts Seniorenstiftung-Kuechenhilfe out/seniorenstiftung/kuechenhilfe.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:st:putzfachkraft": "remotion render src/index.ts Seniorenstiftung-Putzfachkraft out/seniorenstiftung/putzfachkraft.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:st:allgemeines": "remotion render src/index.ts Seniorenstiftung-Allgemeines out/seniorenstiftung/allgemeines.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:wtn:erster-tag": "remotion render src/index.ts WTN-ErsterTag out/wtn/01-erster-tag.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:wtn:technik": "remotion render src/index.ts WTN-Technik out/wtn/02-technik.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:wtn:team-sicherheit": "remotion render src/index.ts WTN-TeamSicherheit out/wtn/03-team-sicherheit.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:wtn:arbeitsbedingungen": "remotion render src/index.ts WTN-Arbeitsbedingungen out/wtn/04-arbeitsbedingungen.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:wtn:motivation-aufstieg": "remotion render src/index.ts WTN-MotivationAufstieg out/wtn/05-motivation-aufstieg.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444"
  },
