 ],
 "markers": [
  {
   "frame": 0,
   "name": "#1 Kaltstart-Teaser",
   "note": "Sandra · Fachkrankenschwester Notfallpflege\nO-Ton: Weil das mein Job ist. Das ist meins.\nBild: Gehaltenes Gesicht, roh, kein Logo\nKommentar: OHNE Kontext, KEINE Bauchbinde. Harter Schnitt danach. ~3 s\nSound: Nur Raumton",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 83,
   "name": "#2 VO: Vorurteil",
   "note": "Text: Viele denken: In einem Haus dieser Größe kann man nichts lernen.\nBild: Gesichter-Montage beider Häuser\nKommentar: Reibung zum Teaser. Kein Konter — Frage bleibt offen! ~6 s\nSound: Raumton/Atmo",
   "color": "Yellow",
   "duration": 1
  },
  {
   "frame": 258,
   "name": "#3 VO: Zwei Häuser",
   "note": "Text: Zwei Häuser in Kassel, eine Geschichte. Das Elisabeth Krankenhaus: der akute Moment. Das Marienkrankenhaus: der lange Weg.\nBild: Auftakt Welten-Montage: S1 ↔ S2\nKommentar: Welten-Captions nur Ortsmarken. ~6 s\nSound: Musik setzt leise ein",
   "color": "Yellow",
   "duration": 1
  },
  {
   "frame": 433,
   "name": "#4 Welt 1: akut",
   "note": "Bild: S1: Notaufnahme, Rettungswagen, Mit Rucksack rennen, Herzkatetherlabor (n. n.)\nCaption: „ELISABETH.\"\nKommentar: Nur S1! Schnelle Cuts. ~7 s\nSound: Thema A (Puls)",
   "color": "Green",
   "duration": 1
  },
  {
   "frame": 633,
   "name": "#5 Welt 2: langer Weg",
   "note": "Bild: S2: Beatmungszimmer, Schlafmedizin Überwachungsraum, Kolleginnen am Tisch, Terasse\nCaption: „MARIEN.\"\nKommentar: Nur S2! Halbes Tempo (Antonym). ~7 s\nSound: Thema B (warm)",
   "color": "Green",
   "duration": 1
  },
  {
   "frame": 833,
   "name": "#6 Mensch 1: Berührung",
   "note": "Zoran · Fachpfleger Intensiv\nO-Ton: wenn sich die Gesichter verändern, ne, von schwerstkranken zu lächelnden Menschen, ne. Und […] das nimmt man mit nach Hause,\nBild: Frontal; Zuwendung am Bett (S1)\nKommentar: Akt-2-Auftakt: kein Fachwort. Falschstart „das hat man,\" mittig trimmen; **Out HART 05:07**. ~8 s\nSound: Thema A weich",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 1023,
   "name": "#7 Mensch 2: Sinn",
   "note": "Ramona Tinner · Leitung Intensiv Marien\nO-Ton: es gibt einem schon was, wenn man merkt, die Patienten, ähm, denen geht's besser. Man ist Teil davon, dass es den Menschen besser geht.\nBild: Frontal; Fortschritts-Detail (S2 Beatmungszimmer)\nKommentar: In bei „es gibt einem\" (Bestätigungs-Vorlauf weglassen). ~7 s\nSound: Thema B",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 1217,
   "name": "#8 Mensch 3: Familie",
   "note": "Jessi · Pflegekraft Intensiv\nO-Ton: ich, äh, sag immer, das ist die Familie, die ich nie haben wollte, aber […] der Zusammenhalt ist einfach super.\nBild: Frontal; Team-Momente (S2 Kolleginnen am Tisch)\nKommentar: Langvariante mit Wendung ab 05:07 („ich gehe arbeiten, um Geld zu verdienen, nicht um Freunde zu finden […]\"). ~7 s\nSound: Thema B",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 1426,
   "name": "#9 Werte-Brücke",
   "note": "Christian Reyer · Chefarzt Intensiv, ärztl. Direktor\nO-Ton: Das ist uns ganz wichtig, dass man Medizin nicht zum Selbstzweck macht, sondern eben für die Menschen.\nBild: Kapelle, Statue (S1) → Zuwendung\nCaption: optional: „Liebe sei Tat.\" (Freigabe OFFEN)\nKommentar: Akt-3-Auftakt: der Chefarzt bestätigt das Ethos — dann erst Fakten. ~6 s\nSound: ruhig",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 1573,
   "name": "#10 WENDE: Konter",
   "note": "Christian Reyer · Chefarzt Intensiv, ärztl. Direktor\nO-Ton: wobei wir für 'n vergleichsweise kleines Krankenhaus eine große Intensivstation haben, […] und da auch sehr stolz drauf sind, dass wir das hier moderne Medizin in einem kleinen Krankenhaus machen können.\nBild: Gehaltenes Gesicht\nKommentar: Antwort auf Szene 2. Kurzfassung fest: 00:40–00:45 + 00:52–00:57. 2. Christian-Take in Folge (Scharnier); Bauchbinde über #9/#10. ~10 s\nSound: Musik nimmt sich zurück",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 1830,
   "name": "#11 Beweis visuell",
   "note": "Bild: Geräte-B-Roll: S1 Herzkatetherlabor/Intensivstation → S2 Beatmungszimmer\nCaption: Badge 1: „Zertifiziertes Cardiac Arrest Center.\" → Badge 2: „Zertifiziertes Weaning-Zentrum.\"\nKommentar: Fachbeweis rein visuell (V4-Regel). ~5 s\nSound: Themen im Wechsel",
   "color": "Green",
   "duration": 1
  },
  {
   "frame": 1980,
   "name": "#12 Mut zum Einstieg",
   "note": "Marina · Pflegekraft ZNA (in Fachweiterbildung)\nO-Ton: ganz viele von uns, glaube ich, Zweifel, gerade wenn wir von Station kommen. Aber man lernt es super schnell\nBild: Frontal; Einarbeitung Schulter-an-Schulter (S1 Kolleginnen am Tablet)\nKommentar: Ich-Form (Tabu-sicher). In hart bei „ganz viele von uns\" — Satz beginnt im Redefluss („da haben\"), B-Roll stützt. Brücke zur Weiterbildung. ~6 s\nSound: Thema A weich",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 2151,
   "name": "#13 Substanz: Weiterbildung",
   "note": "Alina · Pflegekraft Weaning\nO-Ton: Also unser Haus bezahlt, äh, die ganze Weiterbildung. […] hundert Prozent von dem Haus getragen.\nBild: Frontal; S2 Kolleginnen am Tisch\nCaption: Card: „Weiterbildung: 100 % vom Haus. Bis zu 39/40 Urlaubstage.\" (freigegeben)\nKommentar: Zweitbeleg Urlaubstage: Ramona 9994 · 08:53–10:25. ~9 s\nSound: verbindet",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 2445,
   "name": "#14 Substanz: Planbarkeit",
   "note": "Johanna · stellv. Leitung ZNA Marien\nO-Ton: Wir haben einen festen Dienstplan mit Dienstzeiten. Zum Beispiel heute für mich acht bis vierzehn Uhr. […] dann kann ich nach Hause gehen.\nBild: Frontal; Übergabe (S2 Notaufnahme)\nKommentar: Out HART nach „gehen.\". Keine Caption (Dopplung). Namensschild blurren. ~9 s\nSound: ruhig",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 2698,
   "name": "#15 Fusion 1",
   "note": "Christian Reyer · Chefarzt Intensiv, ärztl. Direktor\nO-Ton: es ist interessant, wie so zwei Häuser, die sich ja kennen […] zusammenwachsen und eben zu einem werden.\nBild: Frontal → Wechselschnitt beider Häuser\nKommentar: DER Fusions-O-Ton, Kurzfassung (voll bis 03:12 als Option). ~8 s\nSound: Themen nähern sich",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 2915,
   "name": "#16 Fusion 2",
   "note": "Alina · Pflegekraft Weaning\nO-Ton: wir sind ja mit dem Elisabeth Krankenhaus auch zusammen. […] Grade da kommen wir sehr leicht rüber.\nBild: Frontal\nKommentar: Out VOR „Sonst muss man halt immer anfragen\". Caption ersetzt durch VO #17. ~7 s\nSound: —",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 3120,
   "name": "#17 VO: Verbund",
   "note": "Text: Zwei Häuser, ein Träger: Wer hier arbeitet, entwickelt sich weiter — ohne den Arbeitgeber zu wechseln.\nBild: Team-/Übergangs-B-Roll beider Häuser\nKommentar: Ersetzt frühere Caption. ~5 s\nSound: Themen nähern sich",
   "color": "Yellow",
   "duration": 1
  },
  {
   "frame": 3270,
   "name": "#18 STILLE → Peak",
   "note": "Marcel Faller · Leitung ZNA Marien\nO-Ton: was ich ganz besonders hervorheben muss […] dass man hier tatsächlich einfach noch Mensch ist […] einfach einen Riesenpluspunkt hier.\nBild: Gehaltenes Gesicht, Push-In\nKommentar: DIE Antwort auf die Eingangsfrage. Musik UND VO ganz raus. ~18 s\nSound: 1–2 s STILLE vor „…noch Mensch ist\", dann Swell",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 3723,
   "name": "#19 Staffel 1: Team",
   "note": "Simona · Fachkrankenschwester Intensiv (13 J.)\nO-Ton: bei uns ist es so, dass wir ein tolles Team sind. […] meine ich nicht nur die Pflege, meine ich auch die Ärzte. […] das ist nicht überall so.\nBild: Frontal (2er mit Katja)\nKommentar: Simona = Vorstellung 00:51–00:58 (Stimme matchen). Startet die Beständigkeits-Staffel. ~8 s\nSound: Swell trägt",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 4060,
   "name": "#20 Staffel 2: 24 Jahre",
   "note": "Katja · Intensiv-Pflegekraft\nO-Ton: das ist auch genau der Grund, warum ich schon seit vierundzwanzig Jahren hier im Elisabeth-Krankenhaus bin, […] und wir super Kollegen haben.\nBild: Frontal (2er, Gegenschuss)\nCaption: „24 Jahre. Und geblieben.\"\nKommentar: ORGANISCHER Anschluss: „der Grund\" bezieht sich wörtlich auf Simonas #19 (selber Take, dazwischen nur Interviewer). In NACH Scherz (08:16–08:21)! ~13 s\nSound: Swell trägt",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 4452,
   "name": "#21 Staffel 3: 10 Jahre",
   "note": "Martina · Pflegerische Leitung Notaufnahme\nO-Ton: Ich arbeite jetzt schon über zehn Jahre hier und ich find's jeden Tag immer noch toll.\nBild: Frontal\nCaption: „10 Jahre. Jeden Tag.\"\nKommentar: Kurz und klar — 3. Stufe der Staffel. ~4 s\nSound: Musik steigt",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 4576,
   "name": "#22 Bookend: Sandra voll",
   "note": "Sandra · Fachkrankenschwester Notfallpflege\nO-Ton: ich bleib für den Rest meiner Zeit in der Notaufnahme. […] Das ist meins. […] Ist wirklich meins.\nBild: Gehaltenes Gesicht\nKommentar: Staffel-Klimax + Klammer: Teaser-Satz im Kontext, jetzt MIT Bauchbinde. Jumpcuts 03:32–03:35/03:37–03:39/03:41–03:42; Zwischenrufe 03:36 + 03:41 raus. ~9 s\nSound: Musik zieht an",
   "color": "Blue",
   "duration": 1
  },
  {
   "frame": 4718,
   "name": "#23 VO: Auflösung",
   "note": "Text: Zwei Häuser. Ein Versprechen: dass der Mensch zählt. In jedem Dienst. An jedem Bett.\nBild: Wechselschnitt beider Häuser, Teams\nCaption: „ALLES WIR. ALLES HIER.\"\nKommentar: Caption bewusst ≠ VO-Wortlaut. ~9 s\nSound: Themen verschmelzen",
   "color": "Yellow",
   "duration": 1
  },
  {
   "frame": 4968,
   "name": "#24 Drohne",
   "note": "Bild: Mavic: Elisabeth DJI_0402–0416, Marien ab DJI_0417 — Zuordnung NUR über Ordner!\nKommentar: Freigabe OFFEN; Plan B ebenerdig (S1 Eingang, S2 Außenbereich). ~7 s\nSound: Finale",
   "color": "Green",
   "duration": 1
  },
  {
   "frame": 5168,
   "name": "#25 VO: CTA + Endcard",
   "note": "Text: Die Marien-Elisabeth-Kliniken Kassel. Lern uns kennen — bevor du uns googelst.\nBild: Grafik (NIRO Motion): Verbund-Marke\nCaption: „LERN UNS KENNEN, BEVOR DU UNS GOOGELST.\" + Linkziel OFFEN\nKommentar: Endcard: VO + Text identisch (CTA-Ausnahme). Berufstitel nur mit „(m/w/d)\". ~6 s\nSound: Schluss",
