#!/bin/sh
# Nach „git pull" (Merge): Studio-Abgleich mit dem NAS — Chargen, Gedächtnis, LUTs, Abhängigkeiten. Blockiert nie.
# Spec: docs/superpowers/specs/2026-09-17-studio-nas-abgleich-design.md
# Ohne Skript im Stand (älterer Worktree-Branch bei absolutem core.hooksPath) still nichts tun.
skript="$(git rev-parse --show-toplevel)/tools/studio_abgleich.sh"
[ -f "$skript" ] && sh "$skript" --nach-pull
exit 0
